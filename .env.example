# ═══════════════════════════════════════════════════════════════════════════
# COMUNIDAD DE PROGRAMADORES — Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════════
# Copia este archivo a .env y completa los valores reales
# NUNCA subas .env a GitHub ni compartas sus valores

# Token del bot de Discord (generar en https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# OAuth2 Credentials (Discord Developer Portal > OAuth2)
CLIENT_ID=tu_client_id_aqui
CLIENT_SECRET=tu_client_secret_aqui

# Dashboard Session Secret (generar con: python -c "import secrets; print(secrets.token_hex(32))")
DASHBOARD_SECRET=tu_secret_aqui

# Owner Discord ID
OWNER_ID=tu_owner_id_aqui

# Entorno (true/false)
DEBUG=false

# Discloud asigna este puerto automaticamente con TYPE=site
PORT=8080
